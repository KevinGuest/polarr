{
  "$schema": "https://schema.tauri.app/config/2/capability",
  "identifier": "default",
  "description": "Default capabilities for the Polarr desktop shell (chrome webview)",
  "windows": ["main", "chrome-menu"],
  "webviews": ["main", "chrome-menu"],
  "permissions": [
    "core:default",
    "core:menu:default",
    "core:webview:allow-set-webview-focus",
    "core:webview:allow-webview-show",
    "core:webview:allow-webview-hide",
    "core:webview:allow-webview-close",
    "core:webview:allow-set-webview-size",
    "core:webview:allow-set-webview-position",
    "core:webview:allow-set-webview-auto-resize",
    "core:webview:allow-create-webview",
    "core:webview:allow-create-webview-window",
    "core:webview:allow-get-all-webviews",
    "core:window:allow-create",
    "core:window:allow-set-title",
    "core:window:allow-close",
    "core:window:allow-minimize",
    "core:window:allow-maximize",
    "core:window:allow-unmaximize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-is-maximized",
    "core:window:allow-start-dragging",
    "core:window:allow-inner-size",
    "core:window:allow-outer-position",
    "core:window:allow-scale-factor",
    "core:window:allow-set-focus",
    "core:window:allow-set-position",
    "core:window:allow-set-size",
    "core:window:allow-show",
    "core:window:allow-hide",
    "core:window:allow-set-always-on-top",
    "core:app:allow-default-window-icon",
    "core:event:default",
    "allow-get-server-url",
    "allow-set-server-url",
    "allow-clear-server-url",
    "allow-open-server-webview",
    "allow-hide-server-webview",
    "allow-show-server-webview",
    "allow-close-server-webview",
    "allow-server-history-back",
    "allow-server-history-forward",
    "allow-get-server-webview-href",
    "allow-discord-set-presence",
    "allow-discord-clear-presence",
    "allow-discord-probe-presence",
    "allow-offline-set-session",
    "allow-offline-list",
    "allow-offline-has",
    "allow-offline-ids",
    "allow-offline-remove",
    "allow-offline-clear-all",
    "allow-offline-begin-download",
    "updater:default",
    "process:default"
  ]
}

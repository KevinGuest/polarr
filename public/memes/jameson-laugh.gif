<style>
/* Kill the legacy `main { min-height: 600px }` + `main > div { margin: 20px 0 }`
   global rules from style.css. Those were sized for a layout that had
   shorter page content; the new pages (tools/*, sticker pages, etc.)
   already provide their own padding. The leftover bottom margin and
   forced height showed as a "big white gap" between the page content
   and the dark footer on desktop. Let content size itself. */
main{ min-height:auto !important; }
main > div{ margin-top:0 !important; margin-bottom:0 !important; }
.footer{ margin-top:24px; }
.footer .nav-link{color:#aab;font-size:13px;padding:4px 0 !important;display:block;width:100%}.footer .nav-link:hover{color:#fff}
.footer .nav{flex-direction:column !important}
.footer .nav-item{width:100% !important}
.footer .copy-right{color:#777;font-size:12px}
/* Mobile footer: logo row spans full width, every other column in 2-up. */
@media (max-width: 767.98px){
    .footer{ margin-top:32px; }
    .footer .row > [class*="col-"]{
        flex: 0 0 50% !important;
        max-width: 50% !important;
        padding-bottom: 16px;
    }
    /* First column (logo + copyright) takes both columns. */
    .footer .row > [class*="col-"]:first-child{
        flex: 0 0 100% !important;
        max-width: 100% !important;
        text-align: left;
        padding-bottom: 20px;
    }
    /* The Company+Help mobile-only column also spans full width and sits last. */
    .footer .footer-extra-mobile{
        flex: 0 0 100% !important;
        max-width: 100% !important;
        order: 99;
        padding-top: 8px;
        border-top: 1px solid rgba(255,255,255,0.06);
        margin-top: 8px;
    }
    .footer .menu-title h3{ font-size:12px !important; margin-bottom:6px !important; }
    .footer .nav-link{ font-size:12px; padding:2px 0 !important; }
    .footer .nav{ display:flex !important; }
}

/* ── Tool-card pattern (used by /tools/* "Related GIF + video tools") ──
   Equal-height cards regardless of body-text length, single-source styling. */
.gdb-tool-card{
    display:flex; flex-direction:column; flex:1 1 auto;
    padding:14px; background:#fff; border:1px solid #e2e8f0;
    border-radius:10px; text-decoration:none; color:#0f172a;
    transition:border-color .15s, box-shadow .15s;
}
.gdb-tool-card:hover{ border-color:#1796E6; box-shadow:0 4px 12px rgba(23,150,230,.10); }
.gdb-tool-card-title{ font-weight:700; margin-bottom:4px; }
.gdb-tool-card-desc{ color:#475569; font-size:13px; flex:1; }
</style>



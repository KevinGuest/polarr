<header>
    <div class="container">
        <div class="header-wrap d-flex align-items-center justify-content-between">
            
            <a class="navbar-brand ps-md-0 home-url" href="/">
                <div class="d-block default-logo">
                    <img src="/static/src/gifdb.svg" width="auto" height="36" alt="GIFDB">
                </div>
                <div class="d-block sticky-logo">
                    <img src="/static/src/gifdb-sticky-mobile.png" width="auto" height="36" alt="GIFDB">
                </div>
            </a>

            
            <nav class="gdb-nav d-none d-lg-flex align-items-center" style="gap:6px;">
                <a href="/popular-gif-images/" class="gdb-nav-btn" data-panel="panel-categories">Categories <svg width="10" height="6" viewBox="0 0 10 6" fill="none"><path d="M1 1l4 4 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg></a>
                <a href="/sticker/" class="gdb-nav-btn" data-panel="panel-stickers">Stickers <svg width="10" height="6" viewBox="0 0 10 6" fill="none"><path d="M1 1l4 4 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg></a>
                <a href="/popular-gif-images/" class="gdb-nav-btn" data-panel="panel-reactions">Reactions <svg width="10" height="6" viewBox="0 0 10 6" fill="none"><path d="M1 1l4 4 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg></a>
                <a href="/popular-gif-images/" class="gdb-nav-btn" data-panel="panel-trending">Trending <svg width="10" height="6" viewBox="0 0 10 6" fill="none"><path d="M1 1l4 4 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg></a>
                <a href="/tools/" class="gdb-nav-btn" data-panel="panel-tools">Tools <svg width="10" height="6" viewBox="0 0 10 6" fill="none"><path d="M1 1l4 4 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg></a>
            </nav>

            
            <div class="d-flex align-items-center" style="gap:10px;">
